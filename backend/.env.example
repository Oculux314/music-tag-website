NODE_ENV=development
PORT=4000
# Use this URL with the standalone local PostgreSQL container; production uses Neon.
CORS_ORIGIN=http://localhost:5173
DB_URL=postgresql://music_app:music_dev_password@localhost:5432/music_tags

# Use `openssl rand -base64 32` to generate a new secret.
BETTER_AUTH_SECRET="<32-character high-entropy secret key>"
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth callback URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
