{
  "name": "@music-tag/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && tsc-alias -p tsconfig.json",
    "build:aliases": "tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@music-tag/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.22.4",
    "typescript": "7.0.2"
  },
  "volta": {
    "node": "22.12.0",
    "yarn": "4.18.1"
  }
}
